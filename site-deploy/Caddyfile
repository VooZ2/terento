:80 {
  root * /srv
  encode gzip

  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Content-Security-Policy "default-src 'self'; script-src 'self' https://stats.enduristas.lt; connect-src 'self' https://api.terento.app https://res.garmin.com https://stats.enduristas.lt; img-src 'self' data: https://api.terento.app https://res.garmin.com; style-src 'self'; font-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
  }

  # RFC 9727 discovery is available on GET and HEAD, including its Link header.
  header Link "<https://terento.app/.well-known/api-catalog>; rel=api-catalog"
  @apiCatalog path /.well-known/api-catalog
  header @apiCatalog {
    Content-Type "application/linkset+json"
    Cache-Control "public, max-age=300"
    X-Robots-Tag "noindex, nofollow"
  }
  @openAPI path /openapi.json
  header @openAPI Content-Type "application/vnd.oai.openapi+json"
  @agentSkill path /.well-known/agent-skills/*/SKILL.md
  header @agentSkill {
    Content-Type "text/markdown; charset=utf-8"
    Cache-Control "public, max-age=300"
  }
  @ardManifest path /.well-known/ai-catalog.json /.well-known/ard.json
  header @ardManifest {
    Content-Type "application/json"
    Access-Control-Allow-Origin "*"
    Cache-Control "public, max-age=300"
  }

  @assets path *.css *.js *.svg *.png *.jpg *.jpeg *.webp *.avif *.ico *.woff2 *.webmanifest *.xml

  # Admin on api.terento.app loads the brand fonts cross-origin; its CSP font-src already allows this host.
  @brandFonts path /assets/fonts/*.woff2
  header @brandFonts Access-Control-Allow-Origin "https://api.terento.app"
  header @assets Cache-Control "public, max-age=604800"

  @updateManifest path /updates/macos-arm64.json
  header @updateManifest Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  header @updateManifest Pragma "no-cache"

  # Public JSON remains available to clients but is not a search landing page.
  @machineMetadata path *.json
  header @machineMetadata X-Robots-Tag "noindex, nofollow"

  @indexNowKey path_regexp indexNowKey ^/[0-9A-Fa-f]{32}\.txt$
  header @indexNowKey Content-Type "text/plain; charset=utf-8"

  @legacySupportedWatches path /supported-watches /supported-watches/*
  @legacyAdmin path /admin /admin/*
  # /index.html and /de/index.html duplicate the canonical directory URLs.
  @indexFile path_regexp indexFile ^(/(?:[a-zA-Z0-9_-]+/)*)index\.html$
  @negotiatedPage {
    method GET HEAD
    path_regexp negotiatedPage ^/([a-zA-Z0-9_-]+/)*$
  }
  header @negotiatedPage Vary Accept

  handle_errors {
    header X-Robots-Tag "noindex, nofollow"
    rewrite * /404.html
    file_server
  }

  # A section link whose # was encoded (%23) reaches the server as part of the
  # path; send it to the page and section instead of "Page not found". Only
  # plain page paths and URL-encoded hash text qualify, so a path such as
  # /%5Cevil.com%23x can never become an outside redirect.
  @encodedFragment path_regexp encodedFragment "^(/(?:[A-Za-z0-9_-]+/)*(?:[A-Za-z0-9_-]+)?)#([A-Za-z0-9_=&.%+*-]*)$"

  # Broken outside links (2026-11-13): text pasted after /map-styles/ (Markdown
  # leftovers such as /map-styles/**, /map-styles/Good or an emoji) opens the
  # Maps page; its own files have a dot and stay. /llm.txt is a common typo.
  @mapStylesStray {
    path_regexp mapStylesStray ^/((?:de|fr|pl|cs|it)/)?map-styles/[^.]+$
    not file
  }
  @llmTxt path /llm.txt

  route {
    redir @legacySupportedWatches /compatibility/ permanent
    redir @legacyAdmin https://api.terento.app{uri} permanent
    redir @indexFile {re.indexFile.1} permanent
    # Before @mapStylesStray, so /map-styles/%23area=… keeps the shared view.
    redir @encodedFragment "{re.encodedFragment.1}#{re.encodedFragment.2}" permanent
    redir @mapStylesStray /{re.mapStylesStray.1}map-styles/ permanent
    redir @llmTxt /llms.txt permanent

    # Serve generated public-page Markdown only when an agent asks for it.
    @markdown {
      header Accept *text/markdown*
      method GET HEAD
      path_regexp markdownPage ^/([a-zA-Z0-9_-]+/)*$
    }
    handle @markdown {
      rewrite * {path}index.md
      header Vary "Accept"
      header Content-Type "text/markdown; charset=utf-8"
      file_server
    }

    handle {
      file_server
    }
  }
}
