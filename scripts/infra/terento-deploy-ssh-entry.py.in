#!/usr/bin/python3 -I
"""Fixed SSH command dispatcher; installer substitutes only @PROJECT@."""

import os
import re
import subprocess
import sys

PROJECT = '@PROJECT@'
HELPER = '/usr/local/sbin/terento-deploy'
SUDO = '/usr/bin/sudo'

DEPLOY = re.fullmatch(
    r'deploy (sha256:[0-9a-f]{64}) ([0-9a-f]{40})',
    os.environ.get('SSH_ORIGINAL_COMMAND', ''),
)

if PROJECT not in ('site', 'api'):
    print('This SSH principal has no valid fixed deployment role.', file=sys.stderr)
    raise SystemExit(64)

if DEPLOY:
    command = [SUDO, '-n', HELPER, PROJECT, *DEPLOY.groups()]
else:
    print('Only the fixed image deployment command is permitted for this principal.', file=sys.stderr)
    raise SystemExit(64)

raise SystemExit(subprocess.call(
    command,
    stdin=subprocess.DEVNULL,
    cwd='/',
    env={'PATH': '/usr/sbin:/usr/bin:/sbin:/bin'},
))
