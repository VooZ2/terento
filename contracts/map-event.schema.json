{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "map-event.schema.json",
  "title": "Map operation event request",
  "description": "POST /map-events body only. Existing allowlist; UUID normalization, timezone parsing and raw byte limits remain server checks. Custom IMG operations are excluded.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        true
      ],
      "description": "Current server compares with 1 and also accepts true; this documents existing behavior without changing validation."
    },
    "id": {
      "type": "string",
      "description": "Random UUID accepted and normalized by Python UUID; no physical device identifier."
    },
    "operationId": {
      "type": "string",
      "description": "Random UUID linking map events within an operation; no persistent device identity."
    },
    "timestamp": {
      "type": "string",
      "description": "ISO timestamp parsed by datetime.fromisoformat; timezone required."
    },
    "providerId": {
      "$ref": "#/$defs/safeId",
      "not": {
        "pattern": "^[cC][uU][sS][tT][oO][mM]$"
      }
    },
    "mapId": {
      "anyOf": [
        {
          "$ref": "#/$defs/safeId"
        },
        {
          "type": "null"
        }
      ]
    },
    "region": {
      "anyOf": [
        {
          "$ref": "#/$defs/safeId"
        },
        {
          "type": "null"
        }
      ]
    },
    "eventType": {
      "enum": [
        "DOWNLOAD_STARTED",
        "DOWNLOAD_SUCCEEDED",
        "DOWNLOAD_FAILED",
        "INSTALL_SUCCEEDED",
        "INSTALL_FAILED",
        "DOWNLOAD_PROCESSING",
        "DOWNLOAD_CANCELLED",
        "DOWNLOAD_INTERRUPTED"
      ]
    },
    "outcome": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "UNKNOWN"
      ]
    },
    "appBuild": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80,
      "pattern": "\\S"
    },
    "releaseLabel": {
      "$ref": "#/$defs/releaseLabel",
      "description": "SemVer app release identity. Local debug builds end in -local and are purgeable only in the authenticated admin test-data flow."
    },
    "acquisitionId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Random UUID for one component acquisition attempt."
    },
    "componentKind": {
      "enum": [
        "main",
        "contours",
        null
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "operationId",
    "timestamp",
    "providerId",
    "releaseLabel",
    "eventType",
    "outcome"
  ],
  "additionalProperties": false,
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,159}$"
    },
    "releaseLabel": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "eventType": {
            "enum": [
              "DOWNLOAD_PROCESSING",
              "DOWNLOAD_CANCELLED",
              "DOWNLOAD_INTERRUPTED"
            ]
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "required": [
          "acquisitionId",
          "componentKind"
        ],
        "properties": {
          "acquisitionId": {
            "type": "string"
          },
          "componentKind": {
            "enum": [
              "main",
              "contours"
            ]
          },
          "outcome": {
            "const": "UNKNOWN"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "acquisitionId": {
            "type": "string"
          }
        },
        "required": [
          "acquisitionId"
        ]
      },
      "then": {
        "required": [
          "componentKind"
        ],
        "properties": {
          "componentKind": {
            "enum": [
              "main",
              "contours"
            ]
          },
          "eventType": {
            "pattern": "^DOWNLOAD_"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "componentKind": {
            "type": "string"
          }
        },
        "required": [
          "componentKind"
        ]
      },
      "then": {
        "required": [
          "acquisitionId"
        ],
        "properties": {
          "acquisitionId": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "acquisitionId": {
            "type": "string"
          },
          "eventType": {
            "const": "DOWNLOAD_STARTED"
          }
        },
        "required": [
          "acquisitionId",
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "outcome": {
            "const": "UNKNOWN"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "acquisitionId": {
            "type": "string"
          },
          "eventType": {
            "const": "DOWNLOAD_SUCCEEDED"
          }
        },
        "required": [
          "acquisitionId",
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "outcome": {
            "const": "SUCCEEDED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "acquisitionId": {
            "type": "string"
          },
          "eventType": {
            "const": "DOWNLOAD_FAILED"
          }
        },
        "required": [
          "acquisitionId",
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "outcome": {
            "const": "FAILED"
          }
        }
      }
    }
  ]
}
